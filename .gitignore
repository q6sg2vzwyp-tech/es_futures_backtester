# === Python / venv / bytecode ===
.venv/
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.tmp
*.bak
*.lprof

# === OS / editor junk ===
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# === Generic logs ===
*.log
logging/

# === Runtime outputs (should never be committed) ===
run/
backups/
quarantine/
results/
.learnlogs/

# Heartbeat / runtime emitted files (your repo writes these)
heartbeat*.txt
heartbeat*_kv.txt
spawn_trace*.log
paper_trader*.lock
*.stderr.log
*.stdout.log

# === Archives (local-only) ===
archive/
archive_*/

# === "busted"/backup variants produced by patchers ===
*.bak_*
*.busted_*

# === Logs directory: ignore everything except the trade CSV we care about ===
logs/**
!logs/trades_segmented.csv

# === Data handling (CONSERVATIVE) ===
# Do NOT ignore all data/ by default.
data/state/backup_*/
data/state/runtime_state.json
data/state/daily_restart.json
data/state/*.local*
data/state/*.tmp*
data/state/*snapshot*.json

# === Dependency snapshots (choose ONE approach) ===
# If you want to KEEP lock/runtime deps in git, leave these commented.
# requirements_lock.txt
# requirements_runtime.txt

