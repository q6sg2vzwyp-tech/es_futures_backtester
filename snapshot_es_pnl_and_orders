def snapshot_es_pnl_and_orders(
    ib: IB,
    con: Contract,
    last_px: float,
    logger,
):
    """
    Fully compatible version of your function.
    Extended return → now matches paper_trader expectations.
    """

    # --- your existing code preserved ---
    es_avg_px: Optional[float] = None
    es_unreal_pnl = None
    es_open_orders = 0
    es_open_stops = 0
    es_open_limits = 0

    open_order_ids = []
    open_stop_ids = []
    open_limit_ids = []
    stop_px = None
    target_px = None
    acct_unreal_pnl = None
    acct_realized_pnl = None
    acct_netliq = None

    try:
        positions = ib.positions()
        try:
            mult = float(getattr(con, "multiplier", 50) or 50)
        except:
            mult = 50.0

        for p in positions:
            if p.contract.conId != con.conId:
                continue

            qty = float(p.position)
            if qty == 0:
                continue

            raw_avg_cost = float(p.avgCost or 0.0)
            entry_px = raw_avg_cost / mult if raw_avg_cost > 100000 else raw_avg_cost
            es_avg_px = entry_px

            if last_px is not None:
                if es_unreal_pnl is None: es_unreal_pnl = 0.0
                if qty > 0:
                    es_unreal_pnl += (last_px - entry_px) * qty * mult
                else:
                    es_unreal_pnl += (entry_px - last_px) * abs(qty) * mult

    except Exception as e:
        logger.error(f"[hb_pnl] snapshot error: {e}")

    # ------ order scan (extended) ------
    try:
        for t in ib.openTrades():
            if t.contract.conId != con.conId: continue
            status = (t.orderStatus.status or "").lower()
            if status in ("filled","cancelled","inactive"): continue

            oid = t.order.orderId
            es_open_orders += 1
            open_order_ids.append(oid)

            ot = (t.order.orderType or "").upper()
            if ot in ("STP","STOP","STP LMT","TRAIL","TRAILSTOP"):
                es_open_stops += 1
                open_stop_ids.append(oid)
                if stop_px is None:
                    stop_px = t.order.auxPrice or t.order.lmtPrice
            if ot in ("LMT","LIMIT","MIT"):
                es_open_limits += 1
                open_limit_ids.append(oid)
                if target_px is None:
                    target_px = t.order.lmtPrice

    except Exception as e:
        logger.error(f"[hb_orders] scan error: {e}")

    # ------ account PnL ------
    try:
        for v in ib.accountSummary():
            if v.tag == "UnrealizedPnL": acct_unreal_pnl = float(v.value)
            if v.tag == "RealizedPnL":   acct_realized_pnl = float(v.value)
            if v.tag == "NetLiquidation":acct_netliq = float(v.value)
    except Exception as e:
        logger.error(f"[hb_acct] read error: {e}")

    # MUST return 13 values or paper_trader crashes
    return (
        es_avg_px, es_unreal_pnl,
        es_open_orders, es_open_stops, es_open_limits,
        open_order_ids, open_stop_ids, open_limit_ids,
        stop_px, target_px,
        acct_unreal_pnl, acct_realized_pnl, acct_netliq
    )
